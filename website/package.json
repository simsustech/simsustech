{
  "name": "website",
  "productName": "simsustech",
  "version": "0.1.0",
  "description": "Innovation in simple, sustainable technology",
  "license": "UNLICENSED",
  "author": "simsustech",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fastify-ssr-plugin": {
      "import": "./dist/ssr/server/fastify-ssr-plugin.mjs"
    },
    "./hooks": {
      "import": "./dist/ssr/server/virtual_vitrify-hooks.mjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "vitrify dev",
    "dev:ssr": "vitrify dev -m ssr",
    "build": "run-s build:ssg",
    "build:csr": "vitrify build",
    "build:ssr": "vitrify build -m ssr",
    "build:ssg": "vitrify build -m ssg",
    "test": "vitrify test",
    "lint": "eslint --ext .vue --ext .ts src",
    "lint:fix": "eslint --ext .vue --ext .ts src --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "generate:icons": "icon-gen -i logo.svg -o public/ --favicon --favicon-name 'favicon-' --favicon-png-sizes '[32, 48, 96, 128, 256]'"
  },
  "dependencies": {
    "@fastify/middie": "8.1.0",
    "@fastify/static": "6.9.0",
    "@quasar/extras": "1.15.11",
    "@quasar/quasar-ui-qmarkdown": "^2.0.0-beta.6",
    "@quasar/quasar-ui-qmediaplayer": "^2.0.0-beta.6",
    "@simple-site-generator/templates": "^0.1.0",
    "quasar": "2.11.7",
    "vue": "3.2.47",
    "vue-router": "4.1.6"
  },
  "devDependencies": {
    "@types/node": "^18.15.1",
    "@typescript-eslint/eslint-plugin": "5.54.0",
    "@typescript-eslint/parser": "5.54.0",
    "@vitejs/plugin-vue": "4.0.0",
    "@vitrify/tools": "0.1.3",
    "critters": "0.0.16",
    "devcert": "1.2.2",
    "eslint": "8.35.0",
    "eslint-config-prettier": "8.6.0",
    "eslint-plugin-prettier-vue": "4.2.0",
    "eslint-plugin-vue": "9.9.0",
    "fastify": "4.13.0",
    "icon-gen": "3.0.1",
    "npm-run-all": "4.1.5",
    "typescript": "4.9.5",
    "vite": "4.1.4",
    "vite-plugin-markdown": "2.2.0-2",
    "vitrify": "0.11.10"
  }
}
