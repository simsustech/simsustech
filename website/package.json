{
  "name": "website",
  "productName": "simsustech",
  "version": "0.1.0",
  "description": "simsustech company website — built with the simple-site-generator kit",
  "license": "UNLICENSED",
  "author": "simsustech",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "vitrify dev",
    "dev:ssr": "vitrify dev -m ssr",
    "build": "run-s build:ssg",
    "build:csr": "vitrify build",
    "build:ssr": "vitrify build -m ssr",
    "build:ssg": "vitrify build -m ssg",
    "check": "ssg check",
    "preview": "pnpm run build && caddy run --config build/Caddyfile.preview --adapter caddyfile",
    "verify": "ssg verify --ignore \"google*.html\"",
    "test": "vitrify test",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "convert:images": "sh mogrify -format webp -quality 80 ./public/**/*.(jpg|png)",
    "generate:icons": "icon-gen -i logo.svg -o public/ --favicon --favicon-name 'favicon-' --favicon-png-sizes '[32, 48, 96, 128, 256]'"
  },
  "dependencies": {
    "@fastify/middie": "^9.3.6",
    "@fastify/static": "^10.1.6",
    "@quasar/extras": "^2.1.0",
    "@quasar/quasar-ui-qmediaplayer": "^3.0.2",
    "@simple-site-generator/templates": "^0.2.0",
    "quasar": "^2.35.2",
    "unocss-preset-quasar": "^0.7.4",
    "vite-plugin-pwa": "^2.0.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@iconify-json/mdi": "^1.2.3",
    "@types/node": "^26.6.5",
    "@unocss/preset-icons": "^66.11.0",
    "@unocss/preset-web-fonts": "^66.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/reactivity": "^3.5.44",
    "@vue/runtime-core": "^3.5.44",
    "@vue/runtime-dom": "^3.5.44",
    "@vue/server-renderer": "^3.5.44",
    "@vue/shared": "^3.5.44",
    "beasties": "^0.5.5",
    "devcert": "^1.2.3",
    "fastify": "^5.12.7",
    "gray-matter": "^4.0.3",
    "icon-gen": "^5.0.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "simple-site-generator": "^0.2.0",
    "typescript": "^7.0.2",
    "unocss": "^66.11.0",
    "vite": "^8.3.5",
    "vite-plugin-markdown": "^2.2.0",
    "vitrify": "^0.30.0",
    "workbox-window": "^7.4.1"
  }
}
