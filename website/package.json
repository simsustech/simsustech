{
  "name": "website",
  "productName": "simsustech",
  "version": "0.1.0",
  "description": "Innovation in simple, sustainable technology",
  "license": "UNLICENSED",
  "author": "simsustech",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fastify-ssr-plugin": {
      "import": "./dist/ssr/server/fastify-ssr-plugin.mjs"
    },
    "./hooks": {
      "import": "./dist/ssr/server/virtual_vitrify-hooks.mjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "vitrify dev",
    "dev:ssr": "vitrify dev -m ssr",
    "build": "run-s build:ssg",
    "build:csr": "vitrify build",
    "build:ssr": "vitrify build -m ssr",
    "build:ssg": "vitrify build -m ssg",
    "test": "vitrify test",
    "lint": "eslint --ext .vue --ext .ts src",
    "lint:fix": "eslint --ext .vue --ext .ts src --fix",
    "convert:images": "sh mogrify -format webp -quality 80 ./public/**/*.(jpg|png)",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "generate:icons": "icon-gen -i logo.svg -o public/ --favicon --favicon-name 'favicon-' --favicon-png-sizes '[32, 48, 96, 128, 256]'"
  },
  "dependencies": {
    "@fastify/middie": "9.0.3",
    "@fastify/static": "8.0.4",
    "@quasar/extras": "1.16.15",
    "@quasar/quasar-ui-qmarkdown": "^2.0.4",
    "@quasar/quasar-ui-qmediaplayer": "^2.0.0-beta.6",
    "@simple-site-generator/templates": "^0.1.5",
    "quasar": "2.17.6",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.1",
    "@vitrify/tools": "0.3.0",
    "@typescript-eslint/eslint-plugin": "8.19.1",
    "@typescript-eslint/parser": "8.19.1",
    "@types/node": "22.10.5",
    "@vue/reactivity": "3.5.13",
    "@vue/runtime-core": "3.5.13",
    "@vue/runtime-dom": "3.5.13",
    "@vue/server-renderer": "3.5.13",
    "@vue/shared": "3.5.13",
    "animated-unocss": "0.0.6",
    "beasties": "0.2.0",
    "eslint": "9.18.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier-vue": "5.0.0",
    "eslint-plugin-vue": "9.32.0",
    "devcert": "1.2.2",
    "fastify": "5.2.1",
    "icon-gen": "^5.0.0",
    "npm-run-all": "4.1.5",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vite-plugin-markdown": "2.2.0",
    "vitrify": "0.17.3",
    "workbox-window": "7.3.0"
  }
}
