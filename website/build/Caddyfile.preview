# Local preview of the built site — `pnpm preview`, or directly:
#
#   caddy run --config build/Caddyfile.preview --adapter caddyfile
#
# Why a Caddyfile rather than `caddy file-server`: the routes are extensionless
# (`/services` serves `services.html`), and `file-server` has no `try_files` — it
# answers 404 for every page URL. This mirrors the shape of `build/Caddyfile`,
# which is what production runs, so what you check here is what ships.
#
# The port. `pnpm preview` prints the one it uses and passes it in
# (`scripts/preview.mjs`, default 8155); set PREVIEW_PORT to pick another.
#
# Not 8095: that is what a crowd of other Caddyfiles here defaults to, and Caddy
# binds with `reuseport` — two previews on one port both start and the kernel
# alternates between them, so one site's HTML arrives with the other's modules.

# The same security-header snippet production imports, for the same reason: a
# preview that omits them does not show what ships, and `handle_errors` needs its
# own copy because it runs in its own route. See build/Caddyfile for why each
# header is set, and why there is no `includeSubDomains`, `preload` or CSP.
(SecurityHeaders) {
	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
		-Server
	}
}

:{$PREVIEW_PORT:8155} {
	# `root` is relative to the directory the command runs in, which is this
	# package — so it needs no absolute path and survives a different checkout.
	root * ./dist/static

	import SecurityHeaders

	encode gzip

	# The bundler fingerprints every asset as `name-<hash>.ext`; such a file is
	# immutable, so the browser may keep it for a year without revalidating.
	#
	# Rolldown's hashes are base64url, so `-` and `_` appear inside them
	# (`index-1HO4-Wjr.mjs`). A class without `-` left those files alone, and
	# `immutable` then silently did nothing.
	#
	# Exactly eight characters, not "eight or more": an open class also matches a
	# hyphenated word (`server-renderer.mjs`) and would mark a file immutable that
	# is not.
	@hashed path_regexp hashed -[A-Za-z0-9_-]{8}\.(js|mjs|css|woff2|png|jpe?g|webp|svg)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# `hide Caddyfile`: `build/Caddyfile` is copied into the web root, so without
	# this `GET /Caddyfile` hands out the whole configuration. No leading slash —
	# `hide` matches on file name.
	try_files {path}.html {path}
	file_server {
		hide Caddyfile
	}

	# A missing page answers 404 with the site's own error page, rather than
	# ending `try_files` in a file (which would answer 200 — a soft 404).
	handle_errors {
		import SecurityHeaders
		root * ./dist/static
		@notFound expression {err.status_code} == 404
		rewrite @notFound /404.html
		file_server {
			hide Caddyfile
		}
	}
}
